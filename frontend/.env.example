# ChargeIQ NG — Frontend Environment
# Copy to .env and fill in values

# Backend API URL (leave blank to use mock data)
VITE_API_URL=

# AWS Cognito (leave blank to use mock auth)
VITE_COGNITO_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# AWS AppSync (leave blank to use mock realtime)
VITE_APPSYNC_URL=
VITE_APPSYNC_API_KEY=
